# Runner image for EXECUTOR=container.
#
# The portal starts one throwaway container per task from this image:
#
#   docker run --rm -i --user <portal uid>:<gid> --cap-drop ALL \
#     --security-opt no-new-privileges --memory … --cpus … --pids-limit … \
#     -v <project>:/workspace -v <session>:/sessions -v <pi agent dir>:/pi-agent \
#     pithagoras-runner:latest pi --mode rpc --session-dir /sessions
#
# So this image needs exactly three things: the `pi` CLI, the tools a task reaches
# for, and a writable HOME. Everything stateful arrives as a mount — the task must
# not carry anything of its own between runs, or the next task would inherit it.
#
# pi's configuration directory is mounted by the portal (see the patch in
# server/src/executors/index.ts), so every provider set up in Settings → Models —
# an OpenAI-compatible endpoint included — is the one the task runs on.

FROM node:22-slim

# git and openssh-client for real repositories; ca-certificates for HTTPS;
# curl and wget because install scripts assume them; ripgrep, fd and jq because
# agents reach for them constantly.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates curl wget \
      ripgrep fd-find jq unzip procps \
      python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd

# uv, so a task can run Python tooling without installing anything into the image
# (uvx fetches its own interpreter). Same static build the portal image uses,
# pinned so a rebuild does not silently change the toolchain.
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /usr/local/bin/

# A web-search MCP server, in the image so every task container has it on PATH.
# pi takes its MCP servers from the container it runs in — the portal never spawns
# them, it only reads the config — so with EXECUTOR=container the server has to be
# installed here, not on the portal's side.
#
# `selectolax<1` is not optional: free-search-mcp 0.13.1 imports
# `selectolax.parser`, which selectolax 1.0 removed, so an unpinned install raises
# ImportError the moment the server starts. Verified 2026-10-11 against the 0.13.1
# wheel; drop the pin once upstream stops importing that module.
ENV UV_TOOL_BIN_DIR=/usr/local/bin
RUN uv tool install free-search-mcp --with "selectolax<1" \
    && rm -rf /root/.cache/uv

# The same pi the portal's lock file pins, so a task and the portal are one
# version. Bump this when the portal's lock file moves.
ARG PI_VERSION=0.82.1
RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

# REA (reverse engineering CLI + MCP server), pinned like pi above so a rebuild
# does not silently change the toolchain. Installed in the image, not left to a
# task, so every throwaway container has the `rea` command on PATH.
ARG REA_VERSION=6.4.0
RUN npm install -g "rea-agents@${REA_VERSION}" \
    && npm cache clean --force

# REA's workflow skill, at the user-wide location pi discovers (~/.agents/skills).
RUN mkdir -p /root/.agents/skills \
    && cp -R "$(npm root -g)/rea-agents/skills/reverse-engineer-anything" /root/.agents/skills/ \
    && chmod -R a+rX /root/.agents/skills

# --- REA analysis engines ---------------------------------------------------
#
# The CLI alone can only read static JavaScript/Electron and web artifacts. The
# engines below add the two families that need an external toolchain:
#
#   Ghidra + a full JDK  -> native binaries (.exe, ELF, Mach-O)      [GHIDRA_INSTALL_DIR, JAVA_HOME]
#   JADX + apktool       -> Android APKs and managed/dex code        [REA_JADX_MCP_JAR]
#
# Each download is pinned by version *and* SHA-256, in the same spirit as the
# pi/uv/free-search pins above: a rebuild must not silently swap the engine that
# produced a report. Kept in one layer and the archives are deleted after
# extraction, so the runner carries the tools and not the downloads.
#
# Versions verified 2026-10-11: rea doctor --provider ghidra reports healthy and
# a real decompile of /usr/bin/true succeeds; apktool 3.0.3 is detected by
# rea inspect-apktool-client on this exact node:22-slim base. Ghidra's headless
# analysis needs no X/font packages, so none are installed.
ARG GHIDRA_VERSION=12.1.4
ARG GHIDRA_BUILD=20260921
ARG GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db
ARG TEMURIN_JDK_TAG=jdk-21.0.12.1%2B1
ARG TEMURIN_JDK_VERSION=21.0.12.1+1
ARG TEMURIN_JDK_FILE=OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz
ARG TEMURIN_JDK_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
ARG REA_JADX_VERSION=0.7.1
ARG REA_JADX_SHA256=6e5eacf500b64292bfb73c49797c1958f6ee44646e43e868039ae7feb573ff75
ARG APKTOOL_VERSION=3.0.3
ARG APKTOOL_SHA256=dbf930b076c6b9be08d57c449cacefc3bdd6b71ebd59b3066fc0e1f5b14f9423

ENV GHIDRA_INSTALL_DIR=/opt/tools/ghidra_${GHIDRA_VERSION}_PUBLIC \
    JAVA_HOME=/opt/tools/jdk-${TEMURIN_JDK_VERSION} \
    REA_JADX_MCP_JAR=/opt/tools/android/jadx-headless-mcp-${REA_JADX_VERSION}-all.jar

RUN set -eux; \
    mkdir -p /opt/tools/android /tmp/rea-engines; \
    cd /tmp/rea-engines; \
    curl -fL --retry 3 -o jdk.tar.gz \
      "https://github.com/adoptium/temurin21-binaries/releases/download/${TEMURIN_JDK_TAG}/${TEMURIN_JDK_FILE}"; \
    echo "${TEMURIN_JDK_SHA256}  jdk.tar.gz" | sha256sum -c -; \
    curl -fL --retry 3 -o ghidra.zip \
      "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_BUILD}.zip"; \
    echo "${GHIDRA_SHA256}  ghidra.zip" | sha256sum -c -; \
    curl -fL --retry 3 -o "${REA_JADX_MCP_JAR}" \
      "https://github.com/1013503897/jadx-headless-mcp/releases/download/v${REA_JADX_VERSION}/jadx-headless-mcp-${REA_JADX_VERSION}-all.jar"; \
    echo "${REA_JADX_SHA256}  ${REA_JADX_MCP_JAR}" | sha256sum -c -; \
    curl -fL --retry 3 -o /opt/tools/android/apktool.jar \
      "https://github.com/iBotPeaches/Apktool/releases/download/v${APKTOOL_VERSION}/apktool_${APKTOOL_VERSION}.jar"; \
    echo "${APKTOOL_SHA256}  /opt/tools/android/apktool.jar" | sha256sum -c -; \
    tar -xzf jdk.tar.gz -C /opt/tools; \
    unzip -q ghidra.zip -d /opt/tools; \
    chmod +x "${GHIDRA_INSTALL_DIR}/support/analyzeHeadless" \
      "${GHIDRA_INSTALL_DIR}/Ghidra/Features/Decompiler/os/linux_x86_64/decompile"; \
    printf '#!/bin/sh\nJAVA="${JAVA_HOME:+$JAVA_HOME/bin/java}"\n[ -x "$JAVA" ] || JAVA="%s/bin/java"\nexec "$JAVA" -jar /opt/tools/android/apktool.jar "$@"\n' "${JAVA_HOME}" > /usr/local/bin/apktool; \
    chmod 755 /usr/local/bin/apktool; \
    rm -rf /tmp/rea-engines

# Java on PATH as well as via JAVA_HOME, so a task can run `java -jar`/`keytool`
# without knowing the engine layout. Nothing in the base image provides `java`,
# so this cannot shadow a system JDK.
ENV PATH=${JAVA_HOME}/bin:${PATH}

# Fail the build, not the first task, if an engine did not land correctly. `rea
# doctor` exits 0 even when a provider is unhealthy, so the JSON is checked
# explicitly. apktool is invoked because its launcher (not the JAR) is what rea
# resolves from PATH.
RUN set -eux; \
    rea doctor --provider ghidra --json > /tmp/rea-doctor.json; \
    node -e 'const o=require("/tmp/rea-doctor.json"); if (!o.healthy) { console.error("rea ghidra provider is not healthy"); process.exit(1); } console.log("rea ghidra provider healthy");'; \
    apktool --version; \
    rm -f /tmp/rea-doctor.json

# Register REA's MCP server in pi's user-wide shared MCP config, so every task
# session gets its tools even when the mounted /pi-agent/mcp.json does not name
# it. A same-name entry in /pi-agent/mcp.json (higher precedence) still wins, so
# a deployment can layer provider paths on top from the host. The engine paths
# are written into the entry too: pi spawns the MCP server as a child of the task
# process, so it inherits these, but naming them here keeps a hand-run
# `rea mcp` identical to what pi starts.
RUN mkdir -p /root/.config/mcp \
    && printf '{\n  "mcpServers": {\n    "rea": {\n      "type": "stdio",\n      "command": "/usr/local/bin/rea",\n      "args": ["mcp"],\n      "env": {\n        "GHIDRA_INSTALL_DIR": "%s",\n        "JAVA_HOME": "%s",\n        "REA_JADX_MCP_JAR": "%s"\n      }\n    }\n  }\n}\n' \
      "${GHIDRA_INSTALL_DIR}" "${JAVA_HOME}" "${REA_JADX_MCP_JAR}" > /root/.config/mcp/mcp.json

# The portal's bundled subagent tool, at the same absolute path it has in the
# portal image. Pithagoras' Subagents add-on installs the portal's own copy with
# `pi install /app/extensions/subagent` — a path that exists in the portal's image
# but not in this one, so with EXECUTOR=container the tool could never load. Same
# path here and the one package entry resolves in both. The tool spawns its own
# `pi --mode rpc` children, so it needs no way back to the portal.
#
# Its only non-builtin import is typebox, which it picks up from /app/node_modules
# in the portal image; installed here at the version the portal resolves so both
# run the same one.
COPY extensions/subagent /app/extensions/subagent
RUN mkdir -p /app && cd /app \
    && npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund --save-exact typebox@1.1.38 \
    && npm cache clean --force

ENV PI_CODING_AGENT_DIR=/pi-agent \
    HOME=/root \
    NODE_ENV=production

# The mount points the portal fills in, created here so the image also works when
# one is missing, and so Docker never creates a mount source behind our back.
RUN mkdir -p /pi-agent /workspace /sessions
WORKDIR /workspace
