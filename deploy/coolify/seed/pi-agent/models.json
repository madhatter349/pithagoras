{
  "providers": {
    "clinepass": {
      "name": "ClinePass",
      "baseUrl": "https://api.cline.bot/api/v1",
      "api": "openai-completions",
      "apiKey": "$CLINEPASS_API_KEY",
      "models": [
        {
          "id": "cline-pass/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash-Wafer",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 16384,
          "thinkingLevelMap": {
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "compat": {
            "vercelGatewayRouting": { "only": ["wafer"] }
          }
        }
      ]
    }
  }
}
