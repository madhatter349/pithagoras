# Runner image for EXECUTOR=container.
#
# The portal starts one throwaway container per task from this image:
#
#   docker run --rm -i --user <portal uid>:<gid> --cap-drop ALL \
#     --security-opt no-new-privileges --memory … --cpus … --pids-limit … \
#     -v <project>:/workspace -v <session>:/sessions -v <pi agent dir>:/pi-agent \
#     pithagoras-runner:latest pi --mode rpc --session-dir /sessions
#
# So this image needs exactly three things: the `pi` CLI, the tools a task reaches
# for, and a writable HOME. Everything stateful arrives as a mount — the task must
# not carry anything of its own between runs, or the next task would inherit it.
#
# pi's configuration directory is mounted by the portal (see the patch in
# server/src/executors/index.ts), so every provider set up in Settings → Models —
# an OpenAI-compatible endpoint included — is the one the task runs on.

FROM node:22-slim

# git and openssh-client for real repositories; ca-certificates for HTTPS;
# curl and wget because install scripts assume them; ripgrep, fd and jq because
# agents reach for them constantly.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates curl wget \
      ripgrep fd-find jq unzip procps \
      python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd

# uv, so a task can run Python tooling without installing anything into the image
# (uvx fetches its own interpreter). Same static build the portal image uses,
# pinned so a rebuild does not silently change the toolchain.
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /usr/local/bin/

# A web-search MCP server, in the image so every task container has it on PATH.
# pi takes its MCP servers from the container it runs in — the portal never spawns
# them, it only reads the config — so with EXECUTOR=container the server has to be
# installed here, not on the portal's side.
#
# `selectolax<1` is not optional: free-search-mcp 0.13.1 imports
# `selectolax.parser`, which selectolax 1.0 removed, so an unpinned install raises
# ImportError the moment the server starts. Verified 2026-10-11 against the 0.13.1
# wheel; drop the pin once upstream stops importing that module.
ENV UV_TOOL_BIN_DIR=/usr/local/bin
RUN uv tool install free-search-mcp --with "selectolax<1" \
    && rm -rf /root/.cache/uv

# The same pi the portal's lock file pins, so a task and the portal are one
# version. Bump this when the portal's lock file moves.
ARG PI_VERSION=0.82.1
RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

# REA (reverse engineering CLI + MCP server), pinned like pi above so a rebuild
# does not silently change the toolchain. Installed in the image, not left to a
# task, so every throwaway container has the `rea` command on PATH.
ARG REA_VERSION=6.4.0
RUN npm install -g "rea-agents@${REA_VERSION}" \
    && npm cache clean --force

# REA's workflow skill, at the user-wide location pi discovers (~/.agents/skills).
RUN mkdir -p /root/.agents/skills \
    && cp -R "$(npm root -g)/rea-agents/skills/reverse-engineer-anything" /root/.agents/skills/ \
    && chmod -R a+rX /root/.agents/skills

# Register REA's MCP server in pi's user-wide shared MCP config, so every task
# session gets its tools even when the mounted /pi-agent/mcp.json does not name
# it. A same-name entry in /pi-agent/mcp.json (higher precedence) still wins, so
# a deployment can layer provider paths on top from the host.
RUN mkdir -p /root/.config/mcp \
    && printf '{\n  "mcpServers": {\n    "rea": { "type": "stdio", "command": "/usr/local/bin/rea", "args": ["mcp"] }\n  }\n}\n' > /root/.config/mcp/mcp.json

# The portal's bundled subagent tool, at the same absolute path it has in the
# portal image. Pithagoras' Subagents add-on installs the portal's own copy with
# `pi install /app/extensions/subagent` — a path that exists in the portal's image
# but not in this one, so with EXECUTOR=container the tool could never load. Same
# path here and the one package entry resolves in both. The tool spawns its own
# `pi --mode rpc` children, so it needs no way back to the portal.
#
# Its only non-builtin import is typebox, which it picks up from /app/node_modules
# in the portal image; installed here at the version the portal resolves so both
# run the same one.
COPY extensions/subagent /app/extensions/subagent
RUN mkdir -p /app && cd /app \
    && npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund --save-exact typebox@1.1.38 \
    && npm cache clean --force

ENV PI_CODING_AGENT_DIR=/pi-agent \
    HOME=/root \
    NODE_ENV=production

# The mount points the portal fills in, created here so the image also works when
# one is missing, and so Docker never creates a mount source behind our back.
RUN mkdir -p /pi-agent /workspace /sessions
WORKDIR /workspace
